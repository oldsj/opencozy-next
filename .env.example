# Copy to .env for `make dev`. Development values only: none of these work in production, and
# production gets every secret from its environment (Kubernetes Secret, from 1Password).
DATABASE_URL=postgres://app:app-dev-only@localhost:54329/app?sslmode=disable
# Development uses one role for migrations and serving. Production sets MIGRATION_DATABASE_URL
# (the schema owner) and DATABASE_RUNTIME_ROLE (the role in DATABASE_URL, rows only).
# MIGRATION_DATABASE_URL=
# DATABASE_RUNTIME_ROLE=
LOG_LEVEL=debug
LISTEN_ADDR=127.0.0.1:8080
