# Copy to .env for `make dev`. Development values only: none of these work in production, and
# production gets every secret from its environment (Kubernetes Secret, from 1Password).
DATABASE_URL=postgres://app:app-dev-only@localhost:54329/app?sslmode=disable
# Development uses one role for migrations and serving. Production sets MIGRATION_DATABASE_URL
# (the schema owner) and DATABASE_RUNTIME_ROLE (the role in DATABASE_URL, rows only).
# MIGRATION_DATABASE_URL=
# DATABASE_RUNTIME_ROLE=
LOG_LEVEL=debug
LISTEN_ADDR=127.0.0.1:8080
# Slice 0c. Integration secrets at rest: id:base64key,… (32 random bytes each; the first encrypts).
# Make one with: printf 'dev:%s\n' "$(openssl rand -base64 32)"
# OPENCOZY_SECRET_KEYS=
# Private ranges an integration may reach (RFC 1918 or ULA only), e.g. 192.168.40.0/24
# HOME_ASSISTANT_ALLOWED_PRIVATE_CIDRS=
# OIDC_ALLOWED_PRIVATE_CIDRS=

# The origin people reach OpenCozy at; kid devices are told it when they pair. Without it,
# pairing a device works only on localhost.
# PUBLIC_ORIGIN=https://cozy.example.test

# Google calendar: your own OAuth client ("Web application") in Google Cloud, whose redirect URI
# is PUBLIC_ORIGIN + /api/calendar/google/callback. Needs PUBLIC_ORIGIN and OPENCOZY_SECRET_KEYS.
# Coming from the old app? Reuse its client (GOOGLE_CALENDAR_CLIENT_ID and its secret) and add
# the redirect URI above to it: imported Google tokens only work with the client that issued
# them. With a new client every imported account shows "Sign in again".
# GOOGLE_CLIENT_ID=000000000000-example.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=

# Passkeys: the site's hostname (never change it once passkeys exist) and the origins used.
# WEBAUTHN_RP_ID=cozy.example.test
# WEBAUTHN_ORIGINS=https://cozy.example.test

# Single sign-on for adults (OpenID Connect): the issuer (https), client ID and secret go
# together, and need PUBLIC_ORIGIN; register PUBLIC_ORIGIN/api/auth/callback/oidc at the provider.
# OIDC_NAME is the button text after "Sign in with" (default "single sign-on").
# OIDC_ISSUER=https://id.example.test
# OIDC_CLIENT_ID=
# OIDC_CLIENT_SECRET=
# OIDC_NAME=Example ID

# How recent a sign-in must be to pair, add passkeys or issue credentials (tests only shorten it).
# RECENT_AUTH_WINDOW=10m
