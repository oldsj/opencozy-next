{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "image",
    "config",
    "database",
    "networkPolicy",
    "resources"
  ],
  "properties": {
    "fullnameOverride": {
      "type": "string",
      "maxLength": 50,
      "pattern": "^$|^[a-z0-9]([-a-z0-9]*[a-z0-9])?$"
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 0
    },
    "spread": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "topologyKey": {
          "type": "string",
          "minLength": 1
        },
        "whenUnsatisfiable": {
          "type": "string",
          "enum": [
            "DoNotSchedule",
            "ScheduleAnyway"
          ]
        }
      }
    },
    "podDisruptionBudget": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "minAvailable": {
          "type": [
            "integer",
            "string"
          ]
        }
      }
    },
    "image": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repository",
        "digest"
      ],
      "properties": {
        "repository": {
          "type": "string",
          "pattern": "^[a-z0-9][a-z0-9./_-]*$"
        },
        "digest": {
          "type": "string",
          "pattern": "^$|^sha256:[a-f0-9]{64}$"
        }
      }
    },
    "config": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "logLevel": {
          "enum": [
            "debug",
            "info",
            "warn",
            "error"
          ]
        },
        "sessionTTL": {
          "type": "string",
          "pattern": "^[0-9]+(h|m)$"
        },
        "authRatePerMinute": {
          "type": "integer",
          "minimum": 1
        },
        "trustedProxies": {
          "type": "string"
        },
        "webauthnRPID": {
          "type": "string",
          "pattern": "^[a-z0-9.-]*$"
        },
        "webauthnOrigins": {
          "type": "string"
        },
        "appleTeamID": {
          "type": "string",
          "pattern": "^([A-Z0-9]{10})?$"
        },
        "appleBundleID": {
          "type": "string",
          "pattern": "^([A-Za-z0-9-]+(\\.[A-Za-z0-9-]+)+)?$"
        },
        "apnsKeyID": {
          "type": "string",
          "pattern": "^([A-Z0-9]{10})?$"
        },
        "publicOrigin": {
          "type": "string",
          "pattern": "^(https://[^/?#@]+|http://(localhost|127\\.0\\.0\\.1)(:[0-9]+)?)?$"
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "issuer": {
              "type": "string",
              "pattern": "^(https://[^?#@\\s]+)?$"
            },
            "clientId": {
              "type": "string",
              "maxLength": 255
            },
            "name": {
              "type": "string",
              "maxLength": 40
            }
          }
        }
      }
    },
    "database": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "cnpg": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "instances": {
              "type": "integer",
              "minimum": 1
            },
            "imageName": {
              "type": "string",
              "pattern": "@sha256:[a-f0-9]{64}$"
            },
            "storage": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "size": {
                  "type": "string"
                },
                "storageClass": {
                  "type": "string"
                }
              }
            },
            "resources": {
              "type": "object"
            }
          }
        },
        "existingSecret": {
          "type": "string"
        },
        "urlKey": {
          "type": "string",
          "minLength": 1
        },
        "caSecret": {
          "type": "string"
        },
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "role": {
              "type": "string"
            },
            "existingSecret": {
              "type": "string"
            },
            "urlKey": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      }
    },
    "secrets": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "existingSecret": {
          "type": "string"
        },
        "env": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "name",
              "key"
            ],
            "properties": {
              "name": {
                "type": "string",
                "pattern": "^[A-Z_][A-Z0-9_]*$"
              },
              "key": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        }
      }
    },
    "onepassword": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "itemPath": {
          "type": "string",
          "pattern": "^$|^vaults/[^/]+/items/[^/]+$"
        }
      }
    },
    "route": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "hostname": {
          "type": "string"
        },
        "gateway": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "name": {
              "type": "string"
            },
            "namespace": {
              "type": "string"
            }
          }
        },
        "clusterIssuer": {
          "type": "string"
        }
      }
    },
    "networkPolicy": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "ingressFrom": {
          "type": "array"
        },
        "dnsTo": {
          "type": "array"
        },
        "databaseTo": {
          "type": "array"
        },
        "databasePort": {
          "type": "integer"
        },
        "extraEgress": {
          "type": "array"
        }
      }
    },
    "resources": {
      "type": "object",
      "required": [
        "requests",
        "limits"
      ],
      "properties": {
        "requests": {
          "type": "object",
          "required": [
            "cpu",
            "memory"
          ]
        },
        "limits": {
          "type": "object",
          "required": [
            "memory"
          ]
        }
      }
    },
    "egress": {
      "type": "object",
      "additionalProperties": false,
      "description": "Slice 0c: integration egress (design \u00a710).",
      "properties": {
        "internet": {
          "type": "boolean"
        },
        "homeAssistant": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
              },
              "maxItems": 32
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "maxItems": 8
            }
          }
        },
        "oidc": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "cidrs": {
              "type": "array",
              "items": {
                "type": "string",
                "pattern": "^[0-9a-fA-F.:]+/[0-9]{1,3}$"
              },
              "maxItems": 32
            },
            "ports": {
              "type": "array",
              "items": {
                "type": "integer",
                "minimum": 1,
                "maximum": 65535
              },
              "maxItems": 8
            }
          }
        }
      }
    }
  }
}
